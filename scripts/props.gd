class_name Props
extends RefCounted
## Мелкие операции над расставленными копиями реквизита.
##
## Живёт отдельным классом, потому что нужно и Scatter, и Row, а общего предка у
## них нет: один расставляет случайно, другой по линии, и объединять их ради
## одной функции значило бы городить иерархию под инструмент.


## Убирает у копии физические тела.
##
## Конвейер импорта вешает выпуклый коллайдер на всё подряд — так надёжнее для
## валунов и брёвен. Но трава, галька и доски настила физическими быть не должны:
## игрок цепляется за десятки мелких тел, подъём на ступеньку пытается на каждое
## залезть и каждый кадр переставляет тело — экран дёргается.
##
## Тела именно удаляются, а не глушатся слоями: шестьдесят кустов травы — это
## шестьдесят лишних тел в мире физики, которые всё равно обсчитываются.
static func strip_collision(node: Node) -> void:
	var stack: Array[Node] = [node]
	while not stack.is_empty():
		var current: Node = stack.pop_back()
		if current is CollisionObject3D:
			# Внутрь удаляемого тела не спускаемся: его дети уедут вместе с ним,
			# а обходить помеченные на удаление узлы незачем.
			current.queue_free()
			continue
		stack.append_array(current.get_children())
