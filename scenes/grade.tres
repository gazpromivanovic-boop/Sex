[gd_resource type="Compositor" load_steps=3 format=3]

; Цветокоррекция сцены. Значения в shadows/midtones/highlights — это
; (тон, сила подкраски, насыщенность, светлота); при силе 0 подкраски нет.
;
; Замысел: закат в сцене шёл сплошным оранжевым, и всё в кадре — песок, скалы,
; персонаж — было одного цвета. Тени уводим в холодный синий, света оставляем
; тёплыми. Разведённые по температуре тени и света дают объём, которого не даёт
; ни один источник света.

[ext_resource type="Script" path="res://Compositor/Color grading/ColorGrading.gd" id="1_cg"]

[sub_resource type="CompositorEffect" script_class="ColorGrading" id="Grade"]
